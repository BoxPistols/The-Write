# At least one API key is required
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxx

# デフォルトモデル（省略時: gpt-5.6-luna）
# VITE_DEFAULT_MODEL=gemini-2.5-flash

# パスワード認証（設定時のみ有効、パスワードのみでログイン）
# BASIC_AUTH_PASSWORD=123

# Jev (TypeSafe AI) — 文単位の違和感判定に使う。無くてもアプリは動き、
# 判定の下線とトリアージが止まるだけ。 https://console.typesafe.ai で発行する
TYPESAFE_API_KEY=ts-xxxxxxxxxxxxx

# 既定: https://api.typesafe.ai（記録した応答で回すときだけ差し替える）
# httpsのapi.typesafe.aiとループバックのhttpだけを受け付ける
# TYPESAFE_BASE_URL=http://localhost:8787

# ゲートウェイ経由で使うときだけ、宛先のホストを明示して足す（カンマ区切り）。
# 既定に入れていないのは、APIキーの転送先を増やすのは意図して行う設定だから
# TYPESAFE_ALLOWED_HOSTS=gateway.example.com
# 既定: jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest
# 既定: 6000。遅れた判定は次の打鍵で捨てられるので、長く待たせない
# TYPESAFE_TIMEOUT_MS=6000

# ベンチでJev側の費用を出すときの単価（100万トークンあたりUSD）。
# 渡さないとJevの費用欄は空になる。0として足すと合計が安いほうに寄って嘘になる
# JEV_PRICE_INPUT=0.00
# JEV_PRICE_OUTPUT=0.00
